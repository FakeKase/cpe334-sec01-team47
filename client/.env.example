# Base URL of the YuemPuenMa API. Leave empty to use the same origin (Vite proxies /api to :3000 in dev,
# nginx does it in Docker). Copy to ".env" only if the API is on another origin.
VITE_API_URL=""
# Must match the server's APP_TIMEZONE. Dates such as "Submitted 15 Nov 2026" are shown in this zone.
VITE_APP_TIMEZONE="Asia/Bangkok"
