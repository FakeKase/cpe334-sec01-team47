# Copy this file to ".env" and fill in your own local values.
# Do NOT commit your real .env file.
DATABASE_URL="postgresql://yuempuenma:yuempuenma@localhost:5432/yuempuenma?schema=public"
PORT=3000
APP_TIMEZONE=Asia/Bangkok
BCRYPT_COST=12
# Session lifetime in hours (NFR-04).
SESSION_TTL_HOURS=8

# Seed (bun run prisma:seed). ADMIN_PASSWORD is the Custodian's password.
ADMIN_PASSWORD=change-me
# Demo Borrowers are only created when SEED_DEMO_DATA=true.
SEED_DEMO_DATA=true
DEMO_USER_PASSWORD=change-me
# Adds the demo booking on CPE-0201. Keep false in CI and E2E.
SEED_DEMO_REQUESTS=false
